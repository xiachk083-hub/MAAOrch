    Shell 常驻一条 `adb shell`，写一行就是一次滑动。失败退回一次性 adb。
    """
    try:
        sys.path.insert(0, str(ROOT / "tools"))
        from fastnav import Shell                       # noqa: PLC0415
        Shell.get().swipe(int(x1), int(y1), int(x2), int(y2), int(ms))
    except Exception:                                   # noqa: BLE001
