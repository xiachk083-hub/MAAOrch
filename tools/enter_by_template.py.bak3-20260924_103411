        if page_now() == "曲谱":
            break
        # BACK 键：走常驻服务，别 spawn adb（那正是被禁掉的慢法）
        try:
            urllib.request.urlopen("http://127.0.0.1:8765/key?code=4", timeout=10).read()
        except Exception:
            pass
        time.sleep(1.0)
    if page_now() != "曲谱":
        print("当前不在曲谱页 → 用 to_book() 回曲谱")
        try:
            sys.path.insert(0, str(ROOT / "tools"))
            from enter_event import to_book          # noqa: PLC0415
            to_book("CV", print)
        except Exception as e:                       # noqa: BLE001
            print("to_book 失败：", e)

    # ①b 打开「乐章收录」→「完成进度」
    tap(*BOOK_COLLECT, wait=4.0)
    tap(*TAB_PROGRESS, wait=3.0)

    # ② 归零（用户 2026-09-24 两次提醒：**这页竖直很长，必须滑到最顶**）。
    #    之前我判成"不滚动"是错的（大幅上滑实测像素差 9.1、首行计数被顶边裁掉）⇒ 现在改成
    #    **超滚回弹判据**：用力上滑（手指向下 = 内容向上，回到更上面），滑完等稳定再取帧；
    #    如果这一帧和上一帧几乎一样（中段 ROI 差 < 1.0）⇒ 说明已经在顶、滑不动了。
    #    这比读滚动条靠谱 —— 实测右侧**没有亮滚动条**（整条最大亮度只有 13~31，只有顶部按钮是亮的 212）。
    def _band():
        import urllib.request
        import numpy as np
        import cv2
        p = ROOT / "runtime" / "_zero2.png"
        try:
            urllib.request.urlopen(f"http://127.0.0.1:8765/shot?path={p}", timeout=15).read()
            im = cv2.imread(str(p))
            if im is None:
                return None
            return cv2.resize(cv2.cvtColor(im[110:660, 60:1220], cv2.COLOR_BGR2GRAY), (96, 44),
                              interpolation=cv2.INTER_AREA)
        except Exception:
            return None

    # ②b **先直接在当前屏找**，而且要**轮询等页面就绪**（2026-09-24 实测教训：
    #    点完页签立刻匹配 → 页面还没加载完 ⇒ 找不到卡，然后我白扫 16 屏；
    #    同一个命令隔几分钟再跑就成功，说明纯粹是时序问题）。
    hit = None
    for _try in range(6):
        hit = find_event(a.event)
        if hit:
            print(f"当前屏命中：{a.event} 在 ({hit['x']},{hit['y']}) score={hit['score']}（第 {_try+1} 次尝试）")
            break
        time.sleep(1.5)
    if not hit:
        print("当前屏没命中（页面可能还没就绪）⇒ 再扫几屏")

    print("归零：手指**向下拖**（内容下移 = 露出上面的内容）直到滑不动")
    prev = _band()
    for i in range(1, 11):
        # ⚠️ 方向别搞反（用户 2026-09-24 指出：我一直在"从底部往上滑"，那是往**更下面**走）：
        #   手指向下拖 (90→660) ⇒ 列表内容跟着下移 ⇒ 才是**回到顶部**。
        swipe(640, 90, 640, 660, 450, 1.5)
        cur = _band()
        if prev is None or cur is None:
            break
        import numpy as _np
        d = float(_np.abs(cur.astype(_np.int16) - prev.astype(_np.int16)).mean())
        print(f"  第{i}滑 帧差 {d:.1f}")
        if d < 1.0:
            print("  ⇒ 已经到顶（再滑也不动）")
            break
        prev = cur


    # ③ 直接匹配没中时才走这里：先跳"上次命中的那一屏"（offsets.json 是学出来的位置），
    #    再退化成逐屏扫描。
    off_file = EV_TPL / "offsets.json"
    try:
        offsets = json.loads(off_file.read_text(encoding="utf-8"))
    except Exception:
        offsets = {}
    start_at = int(offsets.get(a.event, {}).get("screen") or 0)
    # ⚠️ 2026-09-24 审计更正：**这页是会滚动的**（实测 `_zero2.png → _zero.png` 中段帧差 49.6；
    #   `runtime/_grid_len.json` 记的 screens=5 也印证了）。旧注释说"不滚动、忽略历史偏移"是错的，
    #   而且它把 `start_at` 顶成 0 ⇒ 紧跟其后的"直奔"分支永远进不去（死代码）。
    #   历史偏移**有用**（上次在第 N 屏命中就直奔第 N 屏），但**必须在归零之后**才可信 ——
    #   所以真正的跳屏逻辑在下面 ②c，且只在"当前屏没命中 + 已归零"时才用。

    # ②c **快路：直接用上次记下的屏数滑到位**（用户 2026-09-24：「除了检测极快，流程也要极快」）。
    #     整页很长（要滑十几屏），每屏都做模板匹配纯属浪费 —— 上次已经知道目标在第 N 屏，
    #     这次就滑 N-1 屏、只在最后一屏匹配。命中就跳过整个扫描循环。
    if not hit:
        try:
            _off = json.loads(off_file.read_text(encoding="utf-8")) if off_file.exists() else {}
            _n = int((_off.get(a.event) or {}).get("screen") or 0)
        except Exception:
            _n = 0
        if _n > 1:
            print(f"快路：按上次记录滑 {_n - 1} 屏直达")
            for _ in range(_n - 1):
                swipe(640, 420, 640, 150, 1100, 0.35)     # 走位不必等停稳，最后一屏才需要
            hit = find_event(a.event)
            if hit:
                print(f"快路命中：{a.event} 在 ({hit['x']},{hit['y']}) score={hit['score']}")

    if not hit:
        # **边滑边检，一直滑到底**（用户 2026-09-24 明确的口径）：
        #   先回到顶部（见上面的归零），再一屏一屏往下滑，**每滑一屏都检测一次**，
        #   直到"再滑也不动"= 到底为止。不要用固定屏数（页长会变，固定数必然漏）。
        import numpy as _np
        prev = _band()
        i = 0
        while i < 30:
            hit = find_event(a.event)
            if hit:
                print(f"第{i+1}屏命中：{a.event} 在 ({hit['x']},{hit['y']}) score={hit['score']}")
                try:
                    offsets[a.event] = {"screen": i + 1, "ts": time.strftime("%Y-%m-%d %H:%M:%S")}
                    off_file.write_text(json.dumps(offsets, ensure_ascii=False, indent=1), encoding="utf-8")
                except Exception:
                    pass
                break
            print(f"第{i+1}屏没有 ⇒ 往下翻一屏（慢拖 + 停稳再截）")
            # ⚠️ 用户 2026-09-24 指出的两点，都写进这里：
            #   ① **一次别滑太多**：这游戏有惯性，快滑会"飞"过好几屏、把中间内容漏掉
            #      ⇒ 用**慢拖**（duration 1200ms）+ **松手前停一下**；
            #   ② **要等停稳再截图**：滑动结束还有惯性余动，立刻截图会拿到糊的中间帧
            #      ⇒ 拖完固定等 2.0s 再取帧。
            swipe(640, 420, 640, 150, 1200, 2.0)
            cur = _band()
            i += 1
            if prev is None or cur is None:
                break
            d = float(_np.abs(cur.astype(_np.int16) - prev.astype(_np.int16)).mean())
            prev = cur
            # 滑到底的判据：**停稳后的两帧几乎一样**（不是"滑动过程中差不多"）
            if d < 1.0:
                print("  ⇒ 已经滑到底（停稳后画面不再变），停止扫描")
                break
        # **就地重试，不重走流程**（2026-09-24 审计重写）：
        #   旧版失败时 `subprocess.run([sys.executable, __file__, ...])` **把整个脚本再跑一遍**
        #   （重新 to_book → 开网格 → 归零 → 扫 16 屏），一次失败就翻倍耗时 —— 正是用户禁掉的
        #   "从头再来"；而且递归那遍**漏传 `--prefix`** ⇒ `looks_like_map("")` 退化成宽松判据，
        #   会把"其实还在完成进度网格页"判成成功。
        #   实测失败率 8/26 = 31%，失败原因多是"页面还没就绪/停在别处" ⇒ 重开页签 + 多等一会儿 + 再扫 3 屏足够。
        print("第一遍没找到 ⇒ 就地重试：重开「完成进度」→ 等就绪 → 再扫最多 3 屏（不重走前面的流程）")
        tap(*TAB_PROGRESS, wait=3.0)
        for _try in range(6):
            hit = find_event(a.event)
            if hit:
                break
            time.sleep(1.5)
        _r = 0
        while not hit and _r < 3:
            swipe(640, 420, 640, 150, 1200, 2.0)
            _r += 1
            hit = find_event(a.event)
        if hit:
            print(f"  就地重试命中：{a.event} 在 ({hit['x']},{hit['y']}) score={hit['score']}")
    if not hit:
        print(json.dumps({"ok": False,
                          "detail": f"两遍都没找到 {a.event}（第一遍 {a.max_screens} 屏 + 就地重试 3 屏）"},
                         ensure_ascii=False))
        return 1

    # ④ 点卡 → 核验详情页 → 进活动
    tap(hit["x"], hit["y"], wait=3.0)
    pg = page_now()
    print("点卡后页面：", pg)
    if pg != "乐章详情":
        print(json.dumps({"ok": False, "detail": f"点了卡但页面是「{pg}」，不是乐章详情"}, ensure_ascii=False))
        return 1
    tap(*find_enter_button(), wait=2.0)
    # **进图确认**（2026-09-24）：点了「进入活动」不等于进去了 —— 实测会被弹回「完成进度」网格
    #   （页面指纹报"未知"，分数 0.747），于是后面所有导航都必然失败。
    #   这里轮询确认真的到了地图；没到就再点一次「进入活动」，仍没到就如实报 ok:false，
    #   交给队列的重试逻辑（而不是假装成功、让导航白跑几分钟）。
    pg2 = ""
    for _try in range(3):
        deadline = time.time() + 5.0
        while time.time() < deadline:
            pg2 = page_now()
            if pg2 in ("活动地图", "关卡详情") or looks_like_map(a.prefix):
                break
            time.sleep(0.4)
        if pg2 in ("活动地图", "关卡详情") or looks_like_map(a.prefix):
            break
        if _try == 0:
            # 实测坐标点不进去 ⇒ 退到"白色长方形"检测（审计：`_guess_enter_button` 之前是死代码）
            _btn = _guess_enter_button()
            print(f"  第 1 次（实测坐标）没进 ⇒ 退到白框检测的按钮 {_btn} 再点一次")
            tap(*_btn, wait=2.5)
            continue
        print(f"  第 {_try+1} 次点「进入活动」后仍不在活动地图（当前「{pg2}」）⇒ 再点一次")
        tap(*find_enter_button(), wait=2.5)
    if pg2 not in ("活动地图", "关卡详情") and not looks_like_map(a.prefix):
        print(json.dumps({"ok": False, "detail": f"点了「进入活动」但仍不在活动地图（当前「{pg2}」）",
                          "event": a.event, "card": hit}, ensure_ascii=False))
        return 1
    # **进 EX 区**：进图后默认在"主区"，EX 关在另一张区域卡上（CV 实测：mt_nav 在主区
    #   找不到 CV-EX-1）。区域卡坐标写在 data/nav_nodes.json 的 zones 里（我读图填的）。
    if a.zone_ex:
        try:
            cfg = json.loads((ROOT / "data" / "nav_nodes.json").read_text(encoding="utf-8"))
            slug_prefix = {"buyizhicai": "CV"}.get(a.event, a.event)
            cards = (cfg.get("zones") or {}).get(slug_prefix, {})
            pt = cards.get("EX")
            if pt:
                print(f"切到 EX 区：点区域卡 {pt}")
                tap(*pt, wait=3.0)
        except Exception as e:                       # noqa: BLE001
            print("切区失败（忽略）：", e)
        pg2 = page_now()
    # 页面指纹只认识少数几张图（PV/MT/EP/LE 的地图）；新活动（如 CV）会报"未知"。
    # 判成功的口径放宽成"**已经不在乐章详情页**"（说明「进入活动」生效了），
    # 这比死等一个我还没学过的页面模板实用。
    # **成功判据**（2026-09-24 审计收紧）：必须是「活动地图/关卡详情」页面指纹，**或**
    #   `looks_like_map(prefix)`（图上有带本活动代号的白框）。旧判据 `pg2 != "乐章详情"` 太松：
    #   停在曲谱/网格/任何别页都会判成功（实测 09:57:34 就是这么报出 `ok:false` 却走到最后的）。
    in_map = pg2 in ("活动地图", "关卡详情") or looks_like_map(a.prefix)
    ok = bool(in_map)
    print(json.dumps({"ok": ok, "page": pg2, "event": a.event, "card": hit}, ensure_ascii=False))
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())
