{"$schema": "http://json-schema.org/draft-07/schema#", "title": "maaorch.audit.v1", "description": "MAAOrch 统一审计事件（docs/MAS_AUDIT_SCHEMA.md）", "type": "object", "required": ["v", "ts", "actor", "action", "target", "result", "reason"], "additionalProperties": false, "properties": {"v": {"const": 1}, "ts": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$", "description": "本地时间（CST），与仓库其它日志同格式"}, "actor": {"type": "string", "pattern": "^(human|worker|tool|sched|host):[^\\s:]+$", "examples": ["tool:mas_ondemand", "worker:mas", "human:xiach", "sched:cron:2600f6415f16"]}, "action": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]+)+$", "examples": ["dispatch.start", "profile.refuse", "audit.rotate"]}, "target": {"type": "string", "pattern": "^(-|[a-z][a-z0-9_]*:[^\\s]+)$", "examples": ["account:帝国猛虎", "dir:E:\\MAA-Multi\\MAA_6", "card:t_d937f659", "-"]}, "result": {"enum": ["ok", "fail", "refused", "info", "unknown"]}, "reason": {"type": "string", "description": "为什么拒绝/失败；无则空串"}, "params": {"type": "object", "description": "脱敏后的输入摘要（≤2000 字符，超长截断留指纹）"}, "evidence": {"type": "array", "items": {"type": "string"}, "description": "证据指针：文件路径/命令/URL（不放内容）"}, "card": {"type": "string", "pattern": "^t_[0-9a-f]{6,}$", "description": "关联看板卡"}, "run_id": {"type": "string"}, "extra": {"type": "object"}}}
